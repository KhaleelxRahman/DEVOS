# DEVOS v1.0.0 Backend — local development environment variables.
# Copy this file to `.env` before starting the server.

# --- Core ---
ENVIRONMENT=development
AUTH_SECRET=CHANGE_ME_LOCAL_DEVELOPMENT_SECRET_0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_APP_URL=http://localhost:5173

# --- Database ---
# Async driver is required (app/db/session.py and Alembic use async engines).
DATABASE_URL=sqlite+aiosqlite:///./data/devos.db
# Production (Render): postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# --- CORS ---
# Comma-separated list or JSON array; both forms are accepted:
#   BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#   BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Only these origins may call the API in a browser (credentials are enabled).
# See also 01-docs/deployment.
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Project workspace storage ---
PROJECTS_STORAGE_PATH=./data/projects

# --- Terminal sandbox ---
TERMINAL_TIMEOUT_SECONDS=30
TERMINAL_MAX_OUTPUT_CHARS=20000

# --- AI providers ("mock" | "gemini" | "openai") ---
# When AI_PROVIDER=mock (or no API key is set) the labelled local-mock
# provider is used so the app works out of the box.
AI_PROVIDER=mock

# AI_MODEL is REQUIRED whenever AI_PROVIDER is a real provider and a key is
# present. There is deliberately NO default: model ids are retired by their
# providers, and silently falling back to an old one produced an HTTP 404
# that looked like a credential problem. Startup now fails fast, naming this
# variable, if it is missing.
# Example (use an id your key can actually reach):
#   AI_MODEL=gemini-2.0-flash
AI_MODEL=

# AI_API_KEY is the shared key variable. GEMINI_API_KEY / OPENAI_API_KEY are
# provider-specific fallbacks; AI_API_KEY wins when both are set.
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
# Optional server-side GitHub token used when no user OAuth token is stored.
GITHUB_TOKEN=

# --- Token encryption at rest ---
# Fernet key that encrypts github_connections.access_token. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Format: a url-safe base64 32-byte key (44 chars incl. '=' padding). It must
# be a VALID Fernet key - a wrong value is rejected at startup in production.
# When empty, saving a GitHub connection fails with TOKEN_ENCRYPTION_UNAVAILABLE
# rather than silently storing a live bearer token in plaintext.
# Rotating this key makes existing stored tokens unreadable; affected users
# must reconnect GitHub.
# PRODUCTION: this variable is REQUIRED - the app refuses to boot without it.
TOKEN_ENCRYPTION_KEY=