# DEVOS Frontend Environment Variables
# Default: same-origin requests through the Vite dev/preview proxy (/api/v1).
# Only set this when the backend is hosted on a different origin.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend origin used by the Vite dev-server proxy for /api.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional website analytics endpoint. When set, public-page page views and
# CTA clicks are sent as anonymous events AFTER the visitor accepts the
# consent banner. Never receives source code, file contents, terminal output,
# AI conversations, tokens, or project data. Leave unset to disable analytics
# entirely (no banner, no tracking).
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com/collect
