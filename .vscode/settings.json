{
    "files.insertFinalNewline":  true,
    "editor.formatOnSave":  true,
    "explorer.sortOrder":  "type",
    "files.exclude":  {
                          "**/.ruff_cache":  true,
                          "**/node_modules":  true,
                          "**/.vercel":  true,
                          "**/.dist":  true,
                          "**/__pycache__":  true,
                          "**/.pytest_cache":  true
                      },
    "explorer.compactFolders":  true,
    "files.trimTrailingWhitespace":  true
}
