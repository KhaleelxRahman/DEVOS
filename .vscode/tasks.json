{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: lint",
      "type": "shell",
      "command": "npm run lint --prefix frontend",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Frontend: type-check",
      "type": "shell",
      "command": "npm run type-check --prefix frontend",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Frontend: build",
      "type": "shell",
      "command": "npm run build --prefix frontend",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Frontend: Playwright",
      "type": "shell",
      "command": "npm run test:e2e --prefix frontend",
      "problemMatcher": []
    },
    {
      "label": "Backend: API tests",
      "type": "shell",
      "command": "python -m pytest tests/api",
      "problemMatcher": []
    }
  ]
}
