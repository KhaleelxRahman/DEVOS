# DEVOS Backend Environment Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=DEVOS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database URL. SQLite is the zero-dependency default for local dev.
# DATABASE_URL=sqlite+aiosqlite:///./devos.db
# PostgreSQL for production-like setups:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devos

# Authentication. MUST be changed in production (>= 32 chars).
AUTH_SECRET=devos-secret-change-in-production-must-be-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Filesystem Root (project workspaces live here)
PROJECTS_STORAGE_PATH=./projects_storage

# AI Provider. Without a key, DEVOS serves clearly-labelled Local/Mock
# responses. Set one of the keys below to enable a real provider.
AI_PROVIDER=gemini          # gemini | openai | (mock when no key)
AI_API_KEY=                  # generic fallback key for either provider
AI_MODEL=                    # optional model override
GEMINI_API_KEY=
OPENAI_API_KEY=

# Terminal sandbox
TERMINAL_TIMEOUT_SECONDS=30
TERMINAL_MAX_OUTPUT_CHARS=20000

# GitHub Integration (OAuth app credentials; optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
