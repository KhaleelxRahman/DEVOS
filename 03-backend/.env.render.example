# DEVOS v1.0.0 Backend — PRODUCTION environment variables (Render).
# Copy each value into the Render service dashboard (or your CI secret store).
# See 01-docs/deployment/DEPLOYMENT.md for the full checklist.

ENVIRONMENT=production

# 48+ random characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_48_CHARS_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_APP_URL=https://devos-ebon.vercel.app

# PostgreSQL via asyncpg (SQLite is rejected by the production guard).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Must include every deployed frontend origin.
BACKEND_CORS_ORIGINS=["https://devos-ebon.vercel.app","https://devos.vercel.app","https://devos-khaleelxrahman.vercel.app"]

PROJECTS_STORAGE_PATH=./data/projects
TERMINAL_TIMEOUT_SECONDS=30
TERMINAL_MAX_OUTPUT_CHARS=20000

# AI stays in labelled mock mode until a real provider + key are added.
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://devos-backend-f3ub.onrender.com/api/v1/github/callback
GITHUB_TOKEN=