# ==============================================
# DEVOS Root Environment Configuration Example
# ==============================================

# Application & Server
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME=DEVOS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (PostgreSQL is production standard; sqlite+aiosqlite supported for local testing)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/devos
# SQLite fallback example for local zero-dependency testing:
# DATABASE_URL=sqlite+aiosqlite:///./devos.db

# Authentication & JWT Security (Generate a secure 32+ char secret in production)
AUTH_SECRET=devos-development-insecure-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Project Filesystem Root
PROJECTS_STORAGE_PATH=./projects_storage

# AI Provider Configuration (P0/P1)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# GitHub Integration Configuration (P1)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173
